<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>FishTank</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net48</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType Condition="'$(BuildCli)' == 'true'">Exe</OutputType>
    <AssemblyName Condition="'$(BuildCli)' == 'true'">FishTank.Cli</AssemblyName>
    <OutputPath Condition="'$(BuildCli)' == 'true'">bin/$(Configuration)/cli/</OutputPath>
    <IntermediateOutputPath Condition="'$(BuildCli)' == 'true'">obj/$(Configuration)/cli/</IntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="FishTank.Collect.ps1" />
    <None Remove="FishTank.png" />
    <EmbeddedResource Include="FishTank.Collect.ps1" LogicalName="FishTank.Collect.ps1" />
    <EmbeddedResource Include="FishTank.png" LogicalName="FishTank.png" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.ServiceProcess">
      </Reference>
    <Reference Include="System.Web.Extensions">
      </Reference>
    <Reference Include="System.Core">
      </Reference>
    <Reference Include="System.Security">
      </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
